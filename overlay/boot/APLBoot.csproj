<Project Sdk="Microsoft.NET.Sdk">

  <!-- APLauncher.Boot: the service that puts the launcher on screen after a full start-up
       (overlay/tizen-manifest.xml, on-boot). Built into the Overlay's .tpk through the
       ProjectReference in ../APLOverlay.csproj, so its APLBoot.dll lands in bin/ next to
       APLOverlay.dll. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-tizen9.0</TargetFramework>
    <AssemblyName>APLBoot</AssemblyName>
    <RootNamespace>APL.Boot</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>None</DebugType>
    <!-- A library inside the Overlay's package, not a package of its own -->
    <TizenCreateTpkOnBuild>false</TizenCreateTpkOnBuild>
  </PropertyGroup>

</Project>
